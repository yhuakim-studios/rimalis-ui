# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
.turbo/

# OpenNext / Cloudflare
.open-next/
.wrangler/

# TypeScript build artefacts.
# next-env.d.ts is GENERATED by `next build`. Committing it also makes the
# first build in a fresh clone a guaranteed Turbo cache miss for every app —
# the file does not exist on run 1, appears on run 2, and changes the input
# hash. Turbo skips gitignored files when hashing, so ignoring it keeps the
# cache stable from the start.
next-env.d.ts
*.tsbuildinfo

# Env — every variant except the templates, which ARE tracked on purpose so a
# fresh clone can see the contract. Same convention as rimalis-api.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
