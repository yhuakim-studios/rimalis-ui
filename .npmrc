# Next and its plugins resolve peers from the app's own node_modules; pnpm's
# strict isolation otherwise hides them and produces "cannot find module react"
# at build time in a workspace.
shamefully-hoist=false
strict-peer-dependencies=false

# Workspace packages must resolve to the local source, never a registry version
# that happens to share the name.
link-workspace-packages=true
prefer-workspace-packages=true
