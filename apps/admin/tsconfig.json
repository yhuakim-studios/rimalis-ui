{
  "extends": "@digistore/config/tsconfig/next.json",
  "compilerOptions": {
    // Per app, not in the shared preset — see the note in
    // packages/config/tsconfig/next.json.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".open-next"]
}
