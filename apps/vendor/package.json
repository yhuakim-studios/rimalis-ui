{
  "name": "@rimalis/vendor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5175",
    "build": "next build",
    "start": "next start --port 5175",
    "typecheck": "tsc --noEmit",
    "clean": "chmod -R u+w .open-next 2>/dev/null; rm -rf .next .open-next .turbo dist",
    "cf:clean": "chmod -R u+w .open-next 2>/dev/null; rm -rf .open-next",
    "cf:build": "pnpm cf:clean && opennextjs-cloudflare build",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@rimalis/api-client": "workspace:*",
    "@rimalis/types": "workspace:*",
    "@rimalis/ui": "workspace:*",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rimalis/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0",
    "vitest": "^4.1.10"
  }
}
